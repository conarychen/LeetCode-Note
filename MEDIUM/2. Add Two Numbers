# [2. Add Two Numbers](https://leetcode.com/problems/add-two-numbers/description/)  
intput -> 兩個linked list 內容為倒序的數字 ( 321會變成 1 -> 2 -> 3 )  
output -> 兩個數相加後 回傳一樣是倒序的linked list  
一格一格相加 並多一個temp 來記錄進位  
最後結束多檢查一次temp是不是還有值要進位

```cpp
/**
 * Definition for singly-linked list.
 * struct ListNode {
 *     int val;
 *     ListNode *next;
 *     ListNode() : val(0), next(nullptr) {}
 *     ListNode(int x) : val(x), next(nullptr) {}
 *     ListNode(int x, ListNode *next) : val(x), next(next) {}
 * };
 */
class Solution {
public:
    ListNode* addTwoNumbers(ListNode* l1, ListNode* l2) {
        ListNode* result = new ListNode(0);
        ListNode* tmpN = result;
        int temp = 0;
        while ( l1 != NULL || l2 != NULL ) {
            tmpN -> next = new ListNode();
            tmpN = tmpN -> next;
            if ( l1 != NULL && l2 != NULL ) {
                temp = l1 -> val + l2 -> val + temp;
                if ( temp >= 10 ) {
                    tmpN -> val = temp%10;
                }
                else {
                    tmpN -> val = temp;
                }
                temp = temp/10;
                l1 = l1 -> next;
                l2 = l2 -> next;
            }
            else if ( l1 == NULL && l2 != NULL ) {
                temp = temp + l2 -> val;
                if ( temp >= 10 ) {
                    tmpN -> val = temp%10;
                }
                else {
                    tmpN -> val = temp;
                }
                temp = temp/10;
                l2 = l2 -> next;
            }
            else if ( l1 != NULL && l2 == NULL ) {
                temp = temp + l1 -> val;
                if ( temp >= 10 ) {
                    tmpN -> val = temp%10;
                }
                else {
                    tmpN -> val = temp;
                }
                temp = temp/10;
                l1 = l1 -> next;
            }

        }

        if ( temp != 0 ) {
            tmpN -> next = new ListNode( temp, NULL );
        }

        result = result -> next;
        return result;

    }
};
```
